# ==========================================================
# MinecraftGuess - Backend
# ==========================================================

# Ambiente
ENVIRONMENT=development

# ----------------------------------------------------------
# MySQL
# ----------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=minecraft_guess
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
# Separar múltiplas origens por vírgula.
#
# Desenvolvimento local:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# Na AWS, usar o domínio do CloudFront.
# Exemplo:
# CORS_ORIGINS=https://xxxxxxxxxxxx.cloudfront.net
